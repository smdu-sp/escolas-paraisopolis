NEXT_PUBLIC_PROJECT_NAME="Base de Desenvolvimento ATIC 2025"

# Auth.js
AUTH_SECRET=cc116b8f56628d7989e573a74c499c88dedbd570c08b13e8883170dfc1daf5a9
AUTH_URL=http://localhost:3001

# Autenticação: "local" pula a validação LDAP (usa só a senha salva no banco).
# Qualquer outro valor exige AUTH_SERVER para autenticar via LDAP.
ENVIRONMENT=local
AUTH_SERVER=
# Base do serviço smul-auth, com a barra final (ex.: http://api.smul.pmsp/auth/)
# Secretarias (campo company do AD) aceitas ao buscar usuário por login. Padrão: SMUL,SPURBANISMO
AUTH_SECRETARIAS=SMUL,SPURBANISMO

# Banco de dados (Prisma - MySQL)
DATABASE_URL=mysql://login:senha@localhost:3306/caminhos_escolares

# Camadas do mapa (opcionais; URLs separadas por vírgula quando houver mais de uma)
NEXT_PUBLIC_GEOJSON_URLS=
NEXT_PUBLIC_KMZ_URLS=
NEXT_PUBLIC_QGIS_WMS_URL=
NEXT_PUBLIC_QGIS_WMS_LAYERS=